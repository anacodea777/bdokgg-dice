<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.BdokggDice" parent="Theme.Material3.Dark.NoActionBar">
        <item name="colorPrimary">@color/brand_orange</item>
        <item name="colorOnPrimary">#000000</item>
        <item name="colorSecondary">@color/brand_orange</item>
        <item name="colorSurface">@color/surface</item>
        <item name="android:colorBackground">@color/brand_black</item>
        <item name="android:windowBackground">@color/brand_black</item>
        <item name="android:statusBarColor">@color/brand_black</item>
        <item name="android:navigationBarColor">@color/brand_black</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="actionOverflowButtonStyle">@style/Widget.BdokggDice.Overflow</item>
    </style>

    <style name="Widget.BdokggDice.Overflow" parent="Widget.AppCompat.ActionButton.Overflow">
        <item name="android:tint">#FFFFFF</item>
    </style>

    <style name="Widget.BdokggDice.StepButton" parent="Widget.Material3.Button.OutlinedButton">
        <item name="android:layout_width">56dp</item>
        <item name="android:layout_height">56dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:padding">0dp</item>
        <item name="iconPadding">0dp</item>
        <item name="iconGravity">textStart</item>
        <item name="iconSize">26dp</item>
        <item name="iconTint">@color/step_icon</item>
        <item name="strokeColor">@color/step_icon</item>
        <item name="strokeWidth">2dp</item>
        <item name="cornerRadius">28dp</item>
    </style>
</resources>
